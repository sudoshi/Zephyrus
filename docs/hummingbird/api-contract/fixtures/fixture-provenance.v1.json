{
    "schema_version": 1,
    "purpose": "Shared PHI-minimized mobile BFF fixture provenance. Every JSON fixture is captured from a real factory-seeded Laravel BFF response; it is never a hand-authored client payload.",
    "regeneration": {
        "command": "HUMMINGBIRD_FIXTURE_DUMP=1 php artisan test --filter='(FlowFixtureRegenerationTest|SharedDtoFixtureRegenerationTest)'",
        "post_generation_checks": [
            "php artisan test tests/Feature/MobileSharedDtoFixtureTest.php --compact",
            "hummingbird/iosApp/scripts/decode-shared-fixtures.swift",
            "./gradlew testDebugUnitTest --tests net.acumenus.hummingbird.data.SharedDtoFixtureDecodeTest"
        ]
    },
    "fixtures": [
