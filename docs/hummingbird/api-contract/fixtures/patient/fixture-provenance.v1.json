{
    "schema_version": 1,
    "purpose": "Patient care-projection fixture provenance. The six care-surface JSON fixtures are captured from the real patient API response generated by the deterministic testing-only projection provisioner. The one forward-compatibility fixture is deterministically derived from the captured pathway-events response to exercise nullable, unknown-enum, additive-field, precision, and large-payload handling. No real patient, production policy, credential, or remote database is used.",
    "regeneration": {
        "command": "HUMMINGBIRD_PATIENT_FIXTURE_DUMP=1 php artisan test --filter=PatientProjectionFixtureRegenerationTest",
        "post_generation_checks": [
            "php artisan test tests/Feature/Patient/PatientProjectionFixtureRegenerationTest.php --compact",
            "php artisan test tests/Feature/Patient/PatientSharedDtoFixtureTest.php --compact",
            "xcodebuild test -project hummingbird/iosPatientApp/HummingbirdPatient.xcodeproj -scheme HummingbirdPatient -only-testing:HummingbirdPatientTests/PatientAPIModelTests/testServerDerivedProjectionFixturesDecodeAcrossEveryCareSurface",
