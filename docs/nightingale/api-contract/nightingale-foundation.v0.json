{
    "openapi": "3.1.1",
    "info": {
        "title": "Nightingale API Governance Foundation",
        "summary": "A deliberately non-runnable contract ownership artifact.",
        "description": "This foundation contains no API operations. It reserves a product-owned namespace for collision prevention but does not register a route or authorize a client, identity flow, patient disclosure, mutation, feature activation, source query, or deployment.",
        "version": "0.0.0-governance"
    },
    "x-nightingale-contract": {
        "product": "Nightingale",
        "audience": "inpatients-and-approved-representatives",
        "governance_status": "foundation-no-operations",
        "artifact_owner": "Patient Experience Platform",
        "backend_boundary_owner": "Zephyrus Patient Experience Boundary",
        "compatibility_input_only": true,
        "route_namespace_reserved": true,
        "route_namespace": "/api/nightingale/v1",
        "compatibility_strategy": "independent-no-alias-no-proxy-no-redirect",
        "client_generation_permitted": false
    },
    "x-nightingale-activation": {
        "default": "disabled",
        "routes_registered": false,
        "route_registration_permitted": false,
        "network_clients_permitted": false,
        "identity_enabled": false,
        "inpatient_source_enabled": false,
        "production_source_query_permitted": false,
        "clinical_approval_recorded": false,
        "patient_content_released": false,
        "feature_activated": false,
        "pilot_enrollment_confirmed": false,
        "source_connector_deployed": false,
        "patient_disclosure_enabled": false,
        "patient_mutation_enabled": false,
        "production_enabled": false,
        "required_before_first_operation": [
            "approved-operation-owner",
            "authorization-and-nondisclosure-tests",
            "identity-and-recovery-decision",
            "institutional-clinical-approval-record",
            "patient-content-release-record",
            "independent-feature-activation-record",
            "expiry-bound-pilot-enrollment",
            "approved-source-connector-deployment",
            "privacy-and-security-review",
            "patient-language-and-accessibility-review",
            "release-and-rollback-plan"
        ]
    },
    "x-nightingale-identifier-policy": {
        "permitted": "opaque-nightingale-product-handles-only",
        "source-system-identifiers": "prohibited",
        "embedded-source-meaning": "prohibited",
        "cross-product-identifiers": "prohibited"
    },
    "servers": [
        {
            "url": "https://nightingale-api.invalid",
            "description": "Reserved non-routable placeholder; this artifact has no operations."
        }
    ],
